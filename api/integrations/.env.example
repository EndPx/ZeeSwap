# Configuration reference only. No loader or automatic activation is installed.
# Use a separately selected isolated integration database, never retained G5 URLs.
ROUTE_STORE_DATABASE_URL=
ROUTE_STORE_EXPECTED_DATABASE=
ROUTE_STORE_INSTANCE_ID=
ROUTE_STORE_DEPLOYMENT_DIGEST=
ROUTE_STORE_STREAM_ID=route:acceptance:reviewed-run-name
# Two independent 32-byte keys; keep stable through restart and outside Git.
ROUTE_STORE_ENCRYPTION_KEY_BASE64=
ROUTE_STORE_LOOKUP_KEY_BASE64=
# Direct administrative URL is for explicit unapplied DDL, never the runtime writer.
ROUTE_STORE_ADMIN_URL=
