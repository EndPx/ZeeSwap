# Server only. Never expose these through frontend env prefixes.
DATABASE_URL=postgresql://zeeswap_api:REPLACE@YOUR-ENDPOINT-pooler.neon.tech/neondb
WORKER_DATABASE_URL=postgresql://zeeswap_worker:REPLACE@YOUR-ENDPOINT-pooler.neon.tech/neondb
# Migration/admin URL belongs in a separate, ignored operator config file.
# 32-byte hex values generated independently; keep outside the database.
ZEE_PAYLOAD_KEY_HEX=
ZEE_LOOKUP_KEY_HEX=
# Explicit primary viewing-only wallet adapter; never point this at a spending wallet.
ZEE_WALLET_PYTHON=
ZEE_WALLET_CONFIG=
