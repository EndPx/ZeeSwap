# Put actual values in ignored .env or a secret manager; never commit them.
# Obtain your own Envio token before starting an indexer. Codegen does not need it.
ENVIO_API_TOKEN=
# Default profile indexes only the existing V1 deployment. V2 remains undeployed.
ZEESWAP_ENABLE_V2=false
# V2 opt-in additionally requires the reviewed public address in config.yaml and here.
ZEESWAP_V2_ADDRESS=
