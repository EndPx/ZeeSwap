# Legacy one-shot SHADOW consumer only; no Chef database, scanner or UFVK access.
# Same value as the Chef query server's CHEF_API_TOKEN, not a second token.
CHEF_API_TOKEN=REPLACE_WITH_SAME_PRIVATE_CHEF_API_TOKEN
# Only the legacy independent zcashd RPC adapter needs this authorization.
ZEESWAP_ZCASH_RPC_AUTHORIZATION="Basic REPLACE_WITH_PRIVATE_BASE64_RPC_USER_PASSWORD"
