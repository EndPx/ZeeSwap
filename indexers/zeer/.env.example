# Template only. Real environment/key files belong in protected private storage.
# Never use an existing ZeeSwap financial database or another Chef project.
ZEESWAP_CHEF_PROJECT=zeeswap_shadow_REPLACE_WITH_FRESH_NAMESPACE
ZEESWAP_CHEF_ACCOUNT_ID=REPLACE_WITH_EXPLICIT_ACCOUNT_ID
ZEESWAP_CHEF_KEY_FINGERPRINT=REPLACE_WITH_INSPECTED_UFVK_FINGERPRINT
ZEESWAP_CHEF_BIRTHDAY=REPLACE_WITH_EXPLICIT_TESTNET_BIRTHDAY
ZEESWAP_CHEF_PREP_URL=https://REPLACE_WITH_AUTHORIZED_PREP_HOST/api/prep
ZEESWAP_CHEF_PREP_TOKEN=REPLACE_WITH_PRIVATE_PREP_TOKEN
ZEESWAP_CHEF_DATABASE_URL=postgresql://REPLACE_WITH_DEDICATED_PRIVATE_CHEF_DATABASE
ZEESWAP_CHEF_SCANNER_EXECUTABLE=/absolute/protected/path/zeer-scanner
ZEESWAP_CHEF_UFVK_FILE=/absolute/protected/path/testnet.ufvk
CHEF_API_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_TOKEN_AT_LEAST_16_BYTES
ZEESWAP_SHADOW_CHEF_TOKEN=REPLACE_WITH_SAME_PRIVATE_CHEF_API_TOKEN
ZEESWAP_ZCASH_RPC_AUTHORIZATION="Basic REPLACE_WITH_PRIVATE_BASE64_RPC_USER_PASSWORD"
