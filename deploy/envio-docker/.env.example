ENVIO_PUBLIC_APP=/opt/zeeswap-testnet/state/envio-docker/public-app-r1
ENVIO_ENGINE_SECRET_STAGE=/opt/zeeswap-testnet/state/envio-docker/engine-secrets-r1
ENVIO_EXPORT_SECRET_STAGE=/opt/zeeswap-testnet/state/envio-docker/export-secrets-r1
ENVIO_ENGINE_SUPERVISION_STATE=/opt/zeeswap-testnet/state/envio-docker/engine-supervision-r1
ENVIO_EXPORT_SUPERVISION_STATE=/opt/zeeswap-testnet/state/envio-docker/export-supervision-r1
ENVIO_ENGINE_CONFIG_SHA256=ROOT_EXACT_ENGINE_DESCRIPTOR_RAW_SHA256
ENVIO_EXPORT_CONFIG_SHA256=ROOT_EXACT_EXPORT_DESCRIPTOR_RAW_SHA256
