# Compose interpolation only. NEVER put database passwords, API tokens or keys here.
ENVIO_DOCKER_IMAGE=sha256:ROOT_QUALIFIED_LOCAL_IMAGE_ID
ENVIO_DOCKER_NODE_IMAGE=node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8
ENVIO_DOCKER_BUILD_CONTEXT=/opt/zeeswap-testnet/state/envio-docker/public-context-r1
ENVIO_DOCKER_NETWORK=zeeswap-envio-source
ENVIO_PUBLIC_APP=/opt/zeeswap-testnet/state/envio-docker/public-app-r1
ENVIO_ENGINE_SECRET_STAGE=/opt/zeeswap-testnet/state/envio-docker/engine-secrets-r1
ENVIO_EXPORT_SECRET_STAGE=/opt/zeeswap-testnet/state/envio-docker/export-secrets-r1
ENVIO_ENGINE_SUPERVISION_STATE=/opt/zeeswap-testnet/state/envio-docker/engine-supervision-r1
ENVIO_EXPORT_SUPERVISION_STATE=/opt/zeeswap-testnet/state/envio-docker/export-supervision-r1
ENVIO_ENGINE_CONFIG_SHA256=ROOT_EXACT_ENGINE_DESCRIPTOR_RAW_SHA256
ENVIO_EXPORT_CONFIG_SHA256=ROOT_EXACT_EXPORT_DESCRIPTOR_RAW_SHA256
# Only when explicitly selecting compose.event-first.yaml with version-2 descriptors:
ENVIO_EVENT_FIRST_PUBLIC_PROJECT=/opt/zeeswap-testnet/state/envio-docker/event-first-public-project-r1
ENVIO_EVENT_FIRST_GENERATED=/opt/zeeswap-testnet/state/envio-docker/event-first-generated-r1

# Explicit v3 datastore overlay only; never reuse old supervision or generated directories.
SDK_DATASTORE_PROOF_FILE=/opt/zeeswap-testnet/state/database-relocation/sdk-stores.private.json
SDK_DATASTORE_METADATA_STAGE=/opt/zeeswap-testnet/state/database-relocation/sdk-metadata-stage-r1
SDK_SOURCE_COMBINED_CA=/opt/zeeswap-testnet/secrets/sdk-primary/source-combined-ca.pem
SDK_ENVIO_EXPORT_PROFILE=/opt/zeeswap-testnet/secrets/sdk-primary/envio-export-profile.private.json
SDK_ENVIO_EXPORT_CREDENTIAL=/opt/zeeswap-testnet/secrets/sdk-primary/envio-export-credentials.private.json

# Mount the host credential file at the exact receipt pin path, per-component only.
SDK_ENVIO_EXPORT_CREDENTIAL_TARGET=/opt/zeeswap-testnet/state/database-relocation/sdk-stores/ROOT_ACTUAL_EXPORT_HOST_FILENAME.private.json
SDK_CHEF_CREDENTIAL_TARGET=/opt/zeeswap-testnet/state/database-relocation/sdk-stores/ROOT_ACTUAL_CHEF_CREDENTIAL_FILENAME.private.json
