# Existing local API only. Start it separately with a deliberately approved config.
VITE_API_BASE_URL=http://127.0.0.1:3031
# Optional developer inspection overlays; never included in production.
VITE_DISABLE_REACT_DEVTOOLS=1

# Root sets the actual separately deployed Base Sepolia faucet after verification.
# Absent address keeps direct USDC claims disabled. Never place keys here.
VITE_USDC_FAUCET_ADDRESS=
